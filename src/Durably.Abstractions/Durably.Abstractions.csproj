<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Durably.Abstractions</PackageId>
    <Description>Contracts for Durably durable workflow execution, including IFlow, IStep, IFlowEngine, and IExecutionStore. Reference this package when you build a store or an integration that should not depend on the engine.</Description>
