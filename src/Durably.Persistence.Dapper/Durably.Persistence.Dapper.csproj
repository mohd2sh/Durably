<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Durably.Persistence.Dapper</PackageId>
    <Description>Driver-agnostic Dapper/raw-SQL IExecutionStore for Durably, with SQL Server, PostgreSQL, and SQLite dialects and idempotent schema bootstrap. EF-free; runs on .NET Framework 4.6.1+ through modern .NET.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Durably.Abstractions\Durably.Abstractions.csproj" />
    <ProjectReference Include="..\Durably.Core\Durably.Core.csproj" />
    <ProjectReference Include="..\Durably.Extensions.DependencyInjection\Durably.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Durably.E2E.Tests" />
  </ItemGroup>

</Project>
