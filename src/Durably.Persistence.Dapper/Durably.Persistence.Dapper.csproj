<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Durably.Persistence.Dapper</PackageId>
    <Description>Dapper persistence for Durably on SQL Server, PostgreSQL, and SQLite. Runs plain SQL against a connection you supply and keeps Entity Framework Core out of the dependency graph.</Description>
    <PackageTags>$(PackageTags);dapper;sqlserver;postgresql;sqlite</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Durably.Abstractions\Durably.Abstractions.csproj" />
    <ProjectReference Include="..\Durably.Core\Durably.Core.csproj" />
    <ProjectReference Include="..\Durably.Extensions.DependencyInjection\Durably.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Durably.E2E.Tests" />
  </ItemGroup>

</Project>
