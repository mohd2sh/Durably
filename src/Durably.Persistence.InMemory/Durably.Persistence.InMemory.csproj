<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <PackageId>Durably.Persistence.InMemory</PackageId>
    <Description>In memory Durably store for tests, samples, and local development. Enable it with UseInMemoryStore. State lives in the process, so use a database store in production.</Description>
    <PackageTags>$(PackageTags);inmemory;testing</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Durably.Abstractions\Durably.Abstractions.csproj" />
    <ProjectReference Include="..\Durably.Core\Durably.Core.csproj" />
    <ProjectReference Include="..\Durably.Extensions.DependencyInjection\Durably.Extensions.DependencyInjection.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Durably.Core.UnitTests" />
    <InternalsVisibleTo Include="Durably.Extensions.DependencyInjection.UnitTests" />
  </ItemGroup>

</Project>
