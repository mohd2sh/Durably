<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Code analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <Authors>Mohammad Shakhtour</Authors>
    <Company>Durably</Company>
    <Product>Durably</Product>
    <Copyright>Copyright (c) 2026 Mohammad Shakhtour</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mohd2sh/Durably</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mohd2sh/Durably</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>https://github.com/mohd2sh/Durably/releases</PackageReleaseNotes>
    <PackageTags>durable-execution;workflow;resume;checkpoint;retry;dotnet</PackageTags>
    <Description>Durable workflows for .NET. Checkpointed steps, crash-safe resume, and optional monitoring in your app.</Description>
  </PropertyGroup>

  <!-- Analyzers + warnings-as-errors for src and tests -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) Or $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)tests'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Tests: empty marker types for Flow.For&lt;TFlow,TState&gt;(); xUnit underscore method names -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)tests'))">
    <NoWarn>$(NoWarn);S2094;CA1707</NoWarn>
  </PropertyGroup>

  <!-- NuGet packaging for publishable src libraries -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src'))">
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) And '$(IsPackable)' != 'false'">
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)docs\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) And '$(IsPackable)' != 'false' And '$(ManagePackageVersionsCentrally)' != 'false'">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) And '$(IsPackable)' != 'false' And '$(ManagePackageVersionsCentrally)' == 'false'">
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="($(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) Or $(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)tests'))) And '$(ManagePackageVersionsCentrally)' != 'false'">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$(MSBuildThisFileDirectory)src')) And '$(ManagePackageVersionsCentrally)' == 'false'">
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.6.0.109712" PrivateAssets="all" />
  </ItemGroup>

</Project>
